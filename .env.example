# ============================================================
#  Vishal — Portfolio  ·  environment
#  Copy to .env  ( `make env` generates it with fresh secrets )
#  NOTHING in this stack is hardcoded. Every secret lives here.
# ============================================================

COMPOSE_PROJECT_NAME=vishal-portfolio
NODE_ENV=development

# ---------- MongoDB ----------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_DB=portfolio
MONGO_APP_USER=portfolio_app
MONGO_APP_PASSWORD=change-me-app
MONGO_PORT=27017

# ---------- Backend ----------
BACKEND_PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Auth (admin panel)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seeded admin user
ADMIN_EMAIL=vishalworks28@gmail.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Vishal

# Privacy: salt for one-way IP hashing (analytics stores no raw IPs)
IP_HASH_SALT=change-me-salt

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CONTACT_RATE_LIMIT_MAX=5
GUESTBOOK_RATE_LIMIT_MAX=3

# Feature flags
ENABLE_GUESTBOOK=true
ENABLE_ANALYTICS=true

# ---------- Frontend ----------
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=8080
VITE_API_URL=/api/v1
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=Vishal
